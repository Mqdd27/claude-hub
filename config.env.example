# Copy to config.env (gitignored) and edit.

# SSH target of the always-on server (key-based login must already work).
SERVER=user@100.x.y.z

# Where to look for CLAUDE.md files to copy (only CLAUDE.md files are sent, never code).
CTX_ROOT="$HOME/Documents"

# Folders whose Claude history and CLAUDE.md must NEVER leave this Mac (space-separated, absolute paths).
EXCLUDE_DIRS="$HOME/Documents/work $HOME/Documents/client-x"

# Agent skill folders on the server, relative to the server user's home (only existing ones get the skill).
SKILL_DIRS=".nanobot/workspace/skills .hermes/skills"

# Sync interval in seconds.
INTERVAL=300
